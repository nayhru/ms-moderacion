    {
      "name": "1. Obtener tokens (requiere ms-usuarios)",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUsuarios}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreUsuario\": \"admin\",\n  \"clave\": \"Admin2026*\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('tokenAdmin', r.token);"
                ]
              }
            }
          ]
        },
